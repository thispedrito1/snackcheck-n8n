    {
      "id": "b315bdd2-31f0-5efc-aa3a-e4e3e36e3845",
      "name": "Format - Verdict Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        3200,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "2adb4de9-b4bb-4a27-a58e-10162e613d7f",
              "name": "message",
              "value": "={{ (() => {\n  const d = $('Code - Concern Score').item.json;\n  const head = { 'saludable': '🥗 ¡Buena elección!', 'moderado': '🙂 Bien, con moderación', 'no saludable': '⚠️ Mejor como gusto ocasional' }[d.verdict_level];\n  const mark = l => l === 'alto' ? '🔴' : '🟢';\n  const row = (label, value, unit, level) => label.padEnd(9) + (String(value) + ' ' + unit).padEnd(10) + mark(level) + ' ' + level;\n  const lines = [\n    head + ' ' + d.product_name + (d.brands ? ' (' + d.brands + ')' : ''),\n    'Veredicto: ' + d.verdict_level.toUpperCase() + ' · Preocupación ' + d.concern_score + '/3',\n    '',\n    'Por 100 g',\n    row('Azúcar', d.sugar, 'g', d.sugar_level),\n    row('Sal', d.salt, 'g', d.salt_level),\n    row('Grasa', d.fat, 'g', d.fat_level),\n    'Energía  ' + (d.energy_kcal !== null ? d.energy_kcal + ' kcal' : 'sin dato'),\n    'Nutri-Score  ' + (d.nutriscore_reading === 'sin dato' ? 'sin dato' : d.nutriscore_grade.toUpperCase()),\n    '',\n    String($json.text || '').trim(),\n  ];\n  return lines.join('\\n');\n})() }}",
              "type": "string"
            }
          ]
        },
        "options": {
          "ignoreConversionErrors": true
        }
      },
      "notes": "Mensaje de varias secciones: titular con emoji, números alineados con 🔴/🟢 y párrafo de la IA.",
      "notesInFlow": true
    },
